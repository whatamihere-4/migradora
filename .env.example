# =============================================================================
# Migradora — Gofile → Filester (minimal)
# Premium transfer account (#2) reads shared folder links from source account (#1).
# Subscription or Pay-As-You-Go both work — same API token from myProfile.
# =============================================================================

# --- Gofile (premium transfer account #2) ---
# Token from https://gofile.io/myProfile (subscription or PAYG account)
GOFILE_TOKEN=
# Comma-separated shared folder URLs from your source account (account #1)
GOFILE_FOLDER_URLS=
# Only if folders are password-protected
GOFILE_PASSWORD=
# CDN mirror preference for downloads (France/EU VPS: eu). auto = API default order.
GOFILE_CDN_PREFER=eu
# Probe each mirror with a 2 MiB sample and pick the fastest (adds ~5–15s per file).
# GOFILE_CDN_PROBE=true
# Parallel Range connections per file (helps high-latency routes). Resume uses single stream.
# GOFILE_DOWNLOAD_CONNECTIONS=4

# --- Real-Debrid (fallback when Gofile traffic limit is hit) ---
# API token from https://real-debrid.com/apitoken
REAL_DEBRID_API_TOKEN=
# Pin CDN host (short name or FQDN), same as apu — e.g. nyk7-4 or 45.download.real-debrid.cloud
# REAL_DEBRID_PREFERRED_CDN=nyk7-4
# REAL_DEBRID_API_BASE=https://api.real-debrid.com/rest/1.0
# REAL_DEBRID_REMOTE=false
# REAL_DEBRID_CONNECT_TIMEOUT_SEC=15
# REAL_DEBRID_READ_TIMEOUT_SEC=60
# REAL_DEBRID_API_MAX_RETRIES=5
# REAL_DEBRID_API_RETRY_DELAY_SEC=30

# --- Filester destination ---
FILESTER_API_KEY=
FILESTER_API_BASE=https://u1.filester.me
FILESTER_ROOT_FOLDER_NAME=VR
# Folder identifier from https://filester.me/f/XXXXXXXX (your VR folder)
FILESTER_ROOT_FOLDER_ID=
# Studio folders inside VR — apu-style JSON {folder_id: name} (copy config/filester-folders.json):
# FILESTER_FOLDERS_FILE=/data/state/filester-folders.json
# Set false to only use folders JSON + FILESTER_ROOT_FOLDER_ID (no API folder create):
FILESTER_AUTO_CREATE_FOLDERS=false
FILESTER_MAX_FILE_BYTES=10200547328
# Split mode for files over FILESTER_MAX_FILE_BYTES:
#   bytes — byte-range parts (cat to rejoin); default, lowest CPU
#   ffmpeg_slice — ffmpeg stream-copy one part at a time (playable parts, same disk peak as bytes)
# Split parts are auto-grouped into a subfolder named after the video (no extra setting).
FILESTER_SPLIT_MODE=bytes
# SPLITTER_FFMPEG_TIMEOUT_SEC=1800
# SPLITTER_FFPROBE_TIMEOUT_SEC=300
# SPLITTER_EXTRACT_BACKEND=ffmpeg   # ffmpeg (fast seek) | mkvmerge (legacy fifo path)
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# MKVMERGE_BIN=mkvmerge

# --- Paths (container paths; mapped in docker-compose) ---
DOWNLOAD_DIR=/data/downloads
STATE_DIR=/data/state
LOG_DIR=/data/logs

# --- Limits ---
# Peak disk per job ≈ source file + one upload part + MIN_FREE_DISK_GB headroom.
# Max source file ≈ DISK_BUDGET_GB - MIN_FREE_DISK_GB - upload part size (~9.5 GiB).
MIN_FREE_DISK_GB=5
DISK_BUDGET_GB=45
# When true, skip jobs that need more disk than available instead of pausing the queue.
DISK_PAUSE_SKIP_JOB=false
# Optional hard cap (GiB). Leave 0 to derive from DISK_BUDGET_GB (~30 GiB with defaults above).
MAX_SOURCE_FILE_GB=0
AUTO_SKIP_OVERSIZED=true
STALE_JOB_TIMEOUT_SEC=3600
# 0 = disabled (Filester ~10 GB limit is per-file, not total account storage)
FILESTER_STORAGE_PAUSE_PCT=0
# Dashboard /status cache for Filester account stats (seconds); avoids API spam during uploads
FILESTER_STATS_CACHE_SEC=60
# Upload tuning (bytes per read chunk, socket write timeout before retry)
FILESTER_UPLOAD_CHUNK_BYTES=1048576
FILESTER_UPLOAD_WRITE_TIMEOUT_SEC=120
# Post-upload status checks (optional; slow Filester API won't block uploads by default)
# FILESTER_VERIFY_UPLOAD=true
# FILESTER_VERIFY_UPLOAD_STRICT=false   # false = trust upload POST if status API is slow/down
# FILESTER_VERIFY_UPLOAD_TIMEOUT_SEC=20 # per-request cap (not 20 minutes)
# FILESTER_VERIFY_UPLOAD_MAX_WAIT_SEC=45

# StashDB — split-part folder title + thumbnail (OSHASH lookup after download)
STASHDB_API_KEY=
STASHDB_GRAPHQL_URL=https://stashdb.org/graphql

# --- Transfer speed caps (0 = unlimited) ---
# Use MBPS or KBPS; if both set for the same direction, MBPS wins.
# DOWNLOAD_THROTTLE_MBPS=0
# DOWNLOAD_THROTTLE_KBPS=0
# UPLOAD_THROTTLE_MBPS=0
# UPLOAD_THROTTLE_KBPS=0

# --- Upload speed watchdog (host: ./scripts/upload-watchdog.sh) ---
# Restarts orchestrator when upload stays below MIN_MBPS for SUSTAIN_SEC.
# POLL_SEC = how often the host script checks; COOLDOWN_SEC = min gap between restarts.
UPLOAD_WATCHDOG_ENABLED=false
UPLOAD_WATCHDOG_MIN_MBPS=5
UPLOAD_WATCHDOG_SUSTAIN_SEC=60
UPLOAD_WATCHDOG_POLL_SEC=10
UPLOAD_WATCHDOG_COOLDOWN_SEC=300

# --- Retries ---
DOWNLOAD_MAX_RETRIES=5
DOWNLOAD_RETRY_DELAY_SEC=30
UPLOAD_MAX_RETRIES=5
UPLOAD_RETRY_DELAY_SEC=30
DISCOVERY_DELAY_SEC=2

# --- Web dashboard ---
# Internal container port only (Caddy upstream: http://migradora:WEBUI_PORT). Not published on the host.
WEBUI_PORT=8080
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SEC=5
TZ=UTC
